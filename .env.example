# Copy to .env (never committed) and fill in what you use.

# --- Brain ---------------------------------------------------------------
# Claude API key from https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
# Optional cheaper / local brains (set provider = "openai_compat" in bot.toml):
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- QQ via NapCat (filled in by `uv run anima napcat init`) -------------
ONEBOT_TOKEN=
NAPCAT_WEBUI_TOKEN=

# --- WeChat official account (公众号) -------------------------------------
WECHAT_MP_TOKEN=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_AES_KEY=

# Bilibili and Douyin logins are QR scans (`uv run anima login bilibili|douyin`);
# their cookies are stored under data/<bot>/secrets and data/<bot>/browser.
