# Copy to .env (never committed) and fill in only what you use.
# 复制为 .env（不会进 git），只填你用到的。也可以在网页「模型提供商」里粘贴 key。

# --- Brain · 大脑 ----------------------------------------------------------
# Claudette's default brain is DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Any other provider in the panel reads its usual variable, for example:
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- magpie gateway (filled in by `uv run anima magpie init`) -------------
MAGPIE_WEB_KEY=

# --- QQ via NapCat (filled in by `uv run anima napcat init`) ---------------
ONEBOT_TOKEN=
NAPCAT_WEBUI_TOKEN=

# --- WeChat official account · 微信公众号 ------------------------------------
WECHAT_MP_TOKEN=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_AES_KEY=

# --- Her OpenAI-compatible endpoint for other frameworks (AstrBot, NoneBot…) --
# Without it, only this computer may call http://127.0.0.1:8765/v1
ANIMA_API_KEY=

# Bilibili and Douyin logins are QR scans (`uv run anima login bilibili|douyin`);
# their cookies stay under data/<bot>/secrets and data/<bot>/browser.
